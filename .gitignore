# Binaries
bin/
dist/

# Web build
web/dist/

# Match at any depth: npm/npx can create a stray node_modules/ at the repo root
# (e.g. running a tool from the wrong directory), not just under web/.
node_modules/

# Generated code. The Go protobuf/Connect output under internal/shared/gen/ is
# committed so the repo is usable without buf: `go build`, `go mod tidy` and any
# tool that just clones the repo (Dependabot) work out of the box. CI verifies it
# is up to date. The TypeScript output is regenerated via `make proto`.
web/gen/
# TanStack Router route tree (regenerated by the router plugin / `tsr generate`)
web/src/routeTree.gen.ts

# SQLite dev database
*.db
*.db-shm
*.db-wal

